# Serial Port Configuration
SERIAL_PORT=COM3
BAUD=115200

# Simulator vs Real Hardware
USE_SIMULATOR=true
SIMULATOR_SCENARIO=normal

# Demo Mode (shortens time windows: 30s instead of 45min, minutes instead of days)
DEMO_MODE=true

# Twilio Configuration (Optional - leave empty to use mock logger)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CAREGIVER_PHONE=+919876543210

# Database
DATABASE_URL=sqlite:///./rebuild.db

# Host & Port
HOST=0.0.0.0
PORT=8000
